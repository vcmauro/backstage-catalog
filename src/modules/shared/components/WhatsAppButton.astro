---
interface Props {
  href: string;
  label?: string;
  size?: 'sm' | 'lg';
}
const { href, label = 'Hacer pedido por WhatsApp', size = 'lg' } = Astro.props;
const sizeClasses = size === 'lg'
  ? 'text-base py-3 px-6'
  : 'text-sm py-2 px-4';
---

  href={href}
  target="_blank"
  rel="noopener"
  class={`flex items-center justify-center gap-2 bg-backstage-whatsapp text-white font-semibold rounded-xl min-h-[44px] w-full ${sizeClasses} active:scale-[0.98] transition-transform`}
>
  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5">
    <path d="M17.6 6.3A8.7 8.7 0 0 0 12 4a8.8 8.8 0 0 0-7.6 13.2L3 21l3.9-1.3A8.8 8.8 0 0 0 12 20.8a8.8 8.8 0 0 0 5.6-15.5ZM12 19.1a7 7 0 0 1-3.6-1l-.3-.2-2.7.9.9-2.6-.2-.3A7.1 7.1 0 1 1 12 19.1Zm3.9-5.3c-.2-.1-1.3-.6-1.5-.7-.2-.1-.3-.1-.5.1l-.7.8c-.1.2-.3.2-.5.1a5.7 5.7 0 0 1-2.8-2.5c-.2-.3.2-.3.5-1 .1-.1 0-.3 0-.4l-.7-1.6c-.2-.4-.4-.4-.5-.4h-.5c-.1 0-.4 0-.6.3a2.6 2.6 0 0 0-.8 1.9c0 1.1.8 2.2.9 2.4.1.1 1.6 2.5 4 3.4.5.2 1 .3 1.3.4.5.2 1 .1 1.4.1.4-.1 1.3-.5 1.5-1 .2-.5.2-.9.1-1Z"/>
  </svg>
  {label}
</a>