---
import '../../styles/global.css';
import { CATEGORY_OPTIONS } from '../../modules/admin/types';
import { BRANDS } from '../../modules/catalog/types';
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Panel</title>
</head>
<body class="bg-backstage-cream min-h-screen">
  <header class="bg-backstage-primary text-white px-4 py-3 flex items-center justify-between">
    <span class="font-bold">Panel de administración</span>
    <button id="logout-btn" class="text-sm underline">Cerrar sesión</button>
  </header>

  <main id="admin-content" class="hidden px-4 py-4 max-w-6xl mx-auto">
    <!-- Fila única en pantallas anchas: buscador + filtros + botón (a la derecha).
         En celular se apila verticalmente. -->
    <div class="flex flex-col sm:flex-row sm:items-center gap-2 mb-4">
      <input id="admin-search" type="search" placeholder="Buscar producto..."
        class="min-h-[44px] px-3 rounded-lg border-2 border-gray-200 focus:outline-none focus:border-backstage-primary sm:flex-1" />

      <select id="admin-category-filter" class="min-h-[44px] px-2 rounded-lg border-2 border-gray-200 text-sm sm:w-48 shrink-0">
        <option value="Todas">Todas las categorías</option>
        {CATEGORY_OPTIONS.map((c) => <option value={c.value}>{c.label}</option>)}
      </select>

      <!-- Solo visible cuando la categoría elegida es "Perfumes" -->
      <select id="admin-brand-filter" class="hidden min-h-[44px] px-2 rounded-lg border-2 border-gray-200 text-sm sm:w-40 shrink-0">
        <option value="Todas">Todas las marcas</option>
        {BRANDS.map((b) => <option value={b}>{b}</option>)}
      </select>

      <select id="admin-availability-filter" class="min-h-[44px] px-2 rounded-lg border-2 border-gray-200 text-sm sm:w-44 shrink-0">
        <option value="Todos">Todos</option>
        <option value="Disponibles">Solo disponibles</option>
        <option value="Ocultos">Solo ocultos</option>
      </select>

      <a href="/panel/producto"
        class="min-h-[44px] leading-[44px] px-5 text-center bg-backstage-primary text-white font-semibold rounded-lg sm:ml-auto shrink-0">
        + Nuevo producto
      </a>
    </div>

    <div id="admin-list-spinner" class="flex flex-col items-center justify-center py-16 text-backstage-primary">
      <div class="w-8 h-8 border-4 border-backstage-primary/30 border-t-backstage-primary rounded-full animate-spin"></div>
      <p class="mt-3 text-sm text-gray-500">Cargando productos...</p>
    </div>

    <!-- Grid: 1 columna en celular, más columnas en pantallas anchas -->
    <div id="admin-product-list" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3"></div>

    <p id="admin-list-empty" class="hidden text-center text-gray-500 py-16">
      No hay productos que coincidan.
    </p>
  </main>
</body>
</html>

<script>
  import { requireAuth } from '../../modules/admin/requireAuth';
  import { logout } from '../../modules/admin/services/authApi';
  import { initAdminList } from '../../modules/admin/adminListState';

  (async () => {
    await requireAuth();
    document.getElementById('admin-content')?.classList.remove('hidden');
    initAdminList();
  })();

  document.getElementById('logout-btn')!.addEventListener('click', async () => {
    await logout();
    window.location.href = '/panel/login';
  });
</script>