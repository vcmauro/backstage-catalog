---
import '../../styles/global.css';
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Ingresar</title>
</head>
<body class="bg-backstage-cream min-h-screen flex items-center justify-center px-4">
  <form id="login-form" class="bg-white rounded-xl shadow-sm p-6 w-full max-w-sm">
    <h1 class="text-xl font-bold text-gray-800 mb-1">Panel de administración</h1>
    <p class="text-sm text-gray-500 mb-6">Backstage</p>

    <label class="block text-sm font-medium text-gray-700 mb-1" for="email">Correo</label>
    <input id="email" type="email" required autocomplete="username"
      class="w-full min-h-[44px] px-3 mb-4 rounded-lg border-2 border-gray-200 focus:outline-none focus:border-backstage-primary" />

    <label class="block text-sm font-medium text-gray-700 mb-1" for="password">Contraseña</label>
    <input id="password" type="password" required autocomplete="current-password"
      class="w-full min-h-[44px] px-3 mb-2 rounded-lg border-2 border-gray-200 focus:outline-none focus:border-backstage-primary" />

    <p id="login-error" class="hidden text-red-600 text-sm mb-4"></p>

    <button type="submit" class="w-full min-h-[44px] bg-backstage-primary text-white font-semibold rounded-lg mt-2">
      Ingresar
    </button>
  </form>
</body>
</html>

<script>
  import { login } from '../../modules/admin/services/authApi';

  const form = document.getElementById('login-form') as HTMLFormElement;
  const errorEl = document.getElementById('login-error')!;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorEl.classList.add('hidden');

    const email = (document.getElementById('email') as HTMLInputElement).value;
    const password = (document.getElementById('password') as HTMLInputElement).value;

    try {
      await login(email, password);
      window.location.href = '/panel';
    } catch (err) {
      errorEl.textContent = err instanceof Error ? err.message : 'Ocurrió un error al ingresar.';
      errorEl.classList.remove('hidden');
    }
  });
</script>