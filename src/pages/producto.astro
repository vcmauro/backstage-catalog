---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Detalle del producto">
  <div id="product-detail-spinner" class="flex flex-col items-center justify-center py-16 text-backstage-primary">
    <div class="w-8 h-8 border-4 border-backstage-primary/30 border-t-backstage-primary rounded-full animate-spin"></div>
    <p class="mt-3 text-sm text-gray-500">Cargando producto...</p>
  </div>

  <div id="product-detail" class="hidden px-4 pt-4 pb-8 max-w-5xl mx-auto md:flex md:gap-10 md:items-start">
    <div class="md:w-1/2">
      <img id="pd-image" class="w-full aspect-square object-cover rounded-xl bg-gray-100" alt="" />
    </div>

    <div class="md:w-1/2 mt-4 md:mt-0">
      <p id="pd-brand" class="text-sm text-gray-500"></p>
      <h1 id="pd-name" class="text-2xl font-bold text-gray-800"></h1>
      <p id="pd-price" class="text-xl font-bold text-backstage-primary mt-2"></p>
      <p id="pd-description" class="hidden text-sm text-gray-600 mt-4 leading-relaxed"></p>
      <div id="pd-whatsapp" class="mt-6"></div>
    </div>
  </div>

  <p id="product-detail-error" class="hidden text-center text-gray-500 py-16">
    No encontramos este producto. Puede que ya no esté disponible.
  </p>
</BaseLayout>

<script>
  import { getProductById } from '../modules/catalog/services/catalogApi';
  import { buildWhatsAppLink } from '../modules/shared/whatsapp';

  const spinner = document.getElementById('product-detail-spinner')!;
  const detail = document.getElementById('product-detail')!;
  const errorEl = document.getElementById('product-detail-error')!;

  const params = new URLSearchParams(window.location.search);
  const id = params.get('id');

  async function load() {
    if (!id) {
      spinner.classList.add('hidden');
      errorEl.classList.remove('hidden');
      return;
    }

    const product = await getProductById(id);
    spinner.classList.add('hidden');

    if (!product || !product.is_available) {
      errorEl.classList.remove('hidden');
      return;
    }

    (document.getElementById('pd-image') as HTMLImageElement).src = product.image_url ?? '/placeholder-product.webp';
    (document.getElementById('pd-image') as HTMLImageElement).alt = product.name;
    document.getElementById('pd-brand')!.textContent = product.brand;
    document.getElementById('pd-name')!.textContent = product.name;
    document.getElementById('pd-price')!.textContent = product.price != null ? `S/ ${product.price.toFixed(2)}` : 'Consultar precio';

    const descriptionEl = document.getElementById('pd-description')!;
    if (product.description) {
      descriptionEl.textContent = product.description;
      descriptionEl.classList.remove('hidden');
    }

    document.getElementById('pd-whatsapp')!.innerHTML = `
      <a href="${buildWhatsAppLink(product)}" target="_blank" rel="noopener"
         class="flex items-center justify-center min-h-[44px] w-full bg-backstage-whatsapp text-white font-semibold rounded-xl py-3">
        Hacer pedido por WhatsApp
      </a>
    `;

    detail.classList.remove('hidden');
  }

  load();
</script>